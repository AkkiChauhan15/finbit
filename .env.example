# Finbit local Docker stack configuration. Copy to `.env` and change the secrets.
JWT_SECRET=replace-with-a-long-random-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-token-secret
FORECAST_API_KEY=replace-with-a-long-random-internal-forecast-key

# Client origin allowed by CORS and used for the login/register split screen.
CLIENT_URL=http://localhost:8080

# Optional: override the API URL baked into the client at build time.
# VITE_API_URL=http://localhost:5000/api
